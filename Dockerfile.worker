ARG BASE_IMAGE=tensorflow/tensorflow:2.15.0-gpu
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TF_CPP_MIN_LOG_LEVEL=3
ENV DISCOCS_DATA_DIR=/worker-data
ENV DISCOCS_DB_PATH=/worker-data/worker-local.db
ENV DISCOCS_MODEL_DIR=/app/models
ENV DISCOCS_INDEX_DIR=/worker-data
ENV DISCOCS_AUDIO_LOADER=ffmpeg
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV CUDA_VISIBLE_DEVICES=0
ENV DISCOCS_WORKER_SERVER=http://192.168.1.41:8711
ENV DISCOCS_WORKER_ID=gpu-worker-1
ENV DISCOCS_WORKER_EMBEDDING_MODEL=discogs_multi
ENV DISCOCS_WORKER_AUDIO_FEATURE_MODEL=audio_features_v1
ENV DISCOCS_WORKER_HEAD_MODEL=discogs-effnet-heads
ENV DISCOCS_WORKER_CLAIM_BATCH_SIZE=32
ENV DISCOCS_WORKER_MAX_INFLIGHT_TASKS=128
ENV DISCOCS_WORKER_DOWNLOAD_CONCURRENCY=8
ENV DISCOCS_WORKER_SUBMIT_BATCH_SIZE=1
ENV DISCOCS_WORKER_LEASE_SECONDS=900
ENV DISCOCS_WORKER_POLL_SECONDS=5
ENV DISCOCS_WORKER_CPU_WORKERS=0
ENV DISCOCS_WORKER_GPU_BATCH_SIZE=64
ENV DISCOCS_WORKER_EMBEDDING_BACKEND=auto
ENV DISCOCS_EFFNET_BACKEND=auto

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        libgomp1 \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -e ".[essentia]" \
    && mkdir -p /worker-data /app/models

CMD exec python -m app.cli worker \
    --server "$DISCOCS_WORKER_SERVER" \
    --worker-id "$DISCOCS_WORKER_ID" \
    --models "$DISCOCS_WORKER_EMBEDDING_MODEL" \
    --models "$DISCOCS_WORKER_AUDIO_FEATURE_MODEL" \
    --models "$DISCOCS_WORKER_HEAD_MODEL" \
    --claim-batch-size "$DISCOCS_WORKER_CLAIM_BATCH_SIZE" \
    --max-inflight-tasks "$DISCOCS_WORKER_MAX_INFLIGHT_TASKS" \
    --download-concurrency "$DISCOCS_WORKER_DOWNLOAD_CONCURRENCY" \
    --submit-batch-size "$DISCOCS_WORKER_SUBMIT_BATCH_SIZE" \
    --lease-seconds "$DISCOCS_WORKER_LEASE_SECONDS" \
    --poll-seconds "$DISCOCS_WORKER_POLL_SECONDS" \
    --cpu-workers "$DISCOCS_WORKER_CPU_WORKERS" \
    --gpu-batch-size "$DISCOCS_WORKER_GPU_BATCH_SIZE" \
    --embedding-backend "$DISCOCS_WORKER_EMBEDDING_BACKEND"
