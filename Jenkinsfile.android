// Отдельный, вручную запускаемый пайплайн для Android-приложения discocs.
// НЕ триггерится Gitea-вебхуком (в отличие от основного Jenkinsfile) — это
// самостоятельная Pipeline-джоба (Script Path: Jenkinsfile.android),
// запускается руками, когда нужен новый APK/OTA-бандл. См. docs/cicd.md
// (раздел "Android job") и docs/android-app.md.
//
// Поток: сборка APK (debug-signed, см. docs/android-app.md — открытый пункт
// про release-подпись) + web OTA-бандл -> запекание в образ frontend (тот же
// deploy/nginx/Dockerfile, просто с непустым deploy/nginx/downloads/) ->
// push в Nexus -> SSH-редеплой ТОЛЬКО сервиса frontend на TARGET_SERVER.
//
// Credentials в Jenkins — те же, что у основного Jenkinsfile:
//   - tank_nexus_user_pass (Username/Password) — логин в Nexus для push
//   - HS_SSH_KEY           (SSH Username with private key) — деплой-ключ

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    // Публичный домен, под который собирается WebView-origin приложения
    // (server.hostname в ui/capacitor.config.ts) — тот же смысл, что
    // DISCOCS_PUBLIC_URL в deploy/prod/.env.example ("канонический внешний
    // origin"), но здесь это build-time значение, запекаемое в APK, а не
    // рантайм-переменная backend'а. Без него capacitor.config.ts откатывается
    // на https://localhost — годится только для локальной проверки сборки,
    // не для реального APK.
    string(name: 'DISCOCS_PUBLIC_URL', defaultValue: '', description: 'Канонический публичный домен (https://...), под который собирается APK')
  }

  environment {
    REGISTRY      = '192.168.1.41:5000'
    IMAGE_NS      = 'discocs'
    TARGET_SERVER = '192.168.1.41'
    TARGET_USER   = 'infected2202'
    TARGET_PORT   = '2252'
    TARGET_DIR    = '/home/infected2202/docker/discocs'
  }

  stages {
    stage('Prepare') {
      steps {
        script {
          env.GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
          if (!params.DISCOCS_PUBLIC_URL?.trim()) {
            error("DISCOCS_PUBLIC_URL parameter is required — the APK's WebView origin is baked in at build time.")
          }
          echo "commit=${env.GIT_SHA} public_url=${params.DISCOCS_PUBLIC_URL}"
        }
      }
    }

    stage('Build APK + OTA bundle') {
      steps {
        sh """
          DOCKER_BUILDKIT=1 docker build \
            --build-arg DISCOCS_PUBLIC_URL='${params.DISCOCS_PUBLIC_URL}' \
            -f deploy/ci/Dockerfile.android -t discocs-android:${GIT_SHA} .
        """
        // create+start+cp, не `docker run --rm -v`: агент собирает через
        // хостовый демон (docker-outside-of-docker), bind-mount воркспейса
        // недоступен — артефакты достаются docker cp'ом из уже остановленного
        // контейнера, тот же паттерн, что для junit/coverage в основном Jenkinsfile.
        sh '''
          set -e
          mkdir -p deploy/nginx/downloads
          CID=$(docker create discocs-android:${GIT_SHA})
          docker cp "$CID:/build/output/discocs.apk" deploy/nginx/downloads/discocs.apk
          docker cp "$CID:/build/output/discocs-web-${GIT_SHA}.zip" "deploy/nginx/downloads/discocs-web-${GIT_SHA}.zip"
          docker cp "$CID:/build/output/update-manifest.json" deploy/nginx/downloads/update-manifest.json
          docker rm -f "$CID"
        '''
        archiveArtifacts artifacts: 'deploy/nginx/downloads/*', fingerprint: true
      }
    }

    stage('Docker Login') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'tank_nexus_user_pass', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
          sh 'echo "$NEXUS_PASS" | docker login "$REGISTRY" -u "$NEXUS_USER" --password-stdin'
        }
      }
    }

    stage('Build & push frontend') {
      steps {
        script {
          def img = "${REGISTRY}/${IMAGE_NS}/frontend"
          // Тот же Dockerfile, что и в основном пайплайне — deploy/nginx/downloads/
          // теперь непустой (APK + zip + manifest из предыдущей стадии),
          // поэтому COPY подхватывает их в образ.
          sh "DOCKER_BUILDKIT=1 docker build --pull -f deploy/nginx/Dockerfile -t ${img}:${GIT_SHA} ."
          sh "docker push ${img}:${GIT_SHA}"
          sh "docker tag ${img}:${GIT_SHA} ${img}:latest"
          sh "docker push ${img}:latest"
        }
      }
    }

    stage('Deploy frontend') {
      steps {
        // Точечный редеплой: только frontend, backend/bot не трогаются —
        // этот пайплайн ничего в них не менял.
        sshagent(['HS_SSH_KEY']) {
          sh '''
            set -e
            ssh -p "$TARGET_PORT" -o StrictHostKeyChecking=no "$TARGET_USER@$TARGET_SERVER" '
              set -e
              cd '"$TARGET_DIR"'
              TAG=latest docker compose -p discocs --env-file .env pull frontend
              TAG=latest docker compose -p discocs --env-file .env up -d --force-recreate --wait --wait-timeout 120 frontend
            '
          '''
        }
        echo "Deployed discocs frontend (Android APK ${env.GIT_SHA}) @ ${params.DISCOCS_PUBLIC_URL}"
      }
    }
  }

  post {
    always {
      sh 'docker image prune -a -f --filter "until=48h" || true'
    }
  }
}
