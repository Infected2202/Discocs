# syntax=docker/dockerfile:1
# Образ для прогона unit-тестов в CI.
# Путь-независим (код кладётся через COPY, а не bind-mount) — работает
# из Jenkins-в-контейнере, где workspace недоступен хостовому демону как путь.
# Essentia не нужна: tests/conftest.py поднимает in-memory SQLite и заглушки модели.
FROM python:3.11

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Зависимости — отдельным слоем до `COPY app`: app меняется почти в каждом
# коммите, и при обратном порядке каждая правка кода переустанавливала весь
# dev-стек. Кэш uv монтируется вдобавок (переживает инвалидацию слоя), иначе
# при смене uv.lock билд заново качает всё по сети.
# --frozen — ставим строго из uv.lock, без пересчёта резолвера (тот же lock,
# что использует Trivy для точного резолвинга версий зависимостей).
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --extra dev

COPY app ./app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --extra dev

COPY scripts ./scripts
COPY tests ./tests
COPY deploy/nginx/default.conf.template ./deploy/nginx/default.conf.template
COPY deploy/backend/Dockerfile ./deploy/backend/Dockerfile
COPY deploy/bot/Dockerfile ./deploy/bot/Dockerfile
# tests/test_deploy_boundary.py проверяет и порядок слоёв самих CI-образов
COPY deploy/ci/Dockerfile.test ./deploy/ci/Dockerfile.test
COPY deploy/ci/Dockerfile.bot-test ./deploy/ci/Dockerfile.bot-test
COPY deploy/prod/docker-compose.yml ./deploy/prod/docker-compose.yml
COPY Jenkinsfile ./Jenkinsfile
COPY .trivyignore.yaml ./.trivyignore.yaml
COPY docker-compose.worker.yml ./docker-compose.worker.yml

ENV PATH="/app/.venv/bin:$PATH"
CMD ["python", "-m", "pytest", "-q", "-n", "auto", "--cov=app", "--cov-report=xml:/app/coverage.xml", "--junitxml=/app/junit-backend.xml"]
