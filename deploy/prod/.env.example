# Прод-окружение для deploy/prod/docker-compose.yml.
# На сервере это файл с секретами — В ГИТ НЕ КОММИТИТСЯ.
# Заполни и положи руками как TARGET_DIR/.env на целевом хосте (см. docs/cicd.md) —
# CI этот файл не деплоит и не трогает, правки на хосте переживают любой билд.

# --- Реестр и тег ---
REGISTRY=192.168.1.41:5000
IMAGE_NS=discocs
TAG=latest                       # latest = последний билд; для отката — конкретный git-sha (напр. a1b2c3d)

# --- Данные сервисов на хосте ---
# Базовый каталог, под ним лежат discocs_backend/, discocs_bot/ и discocs_awg/ (свои
# данные каждого сервиса, без пересечения контекста). Должен существовать до первого up.
DISCOCS_STATE_DIR=/home/infected2202/docker/discocs

# --- Backend ---
DISCOCS_MUSIC_DIR=/path/to/music # хостовый путь к фонотеке, монтируется read-only (должен существовать)

# --- Frontend ---
DISCOCS_HTTP_PORT=80

# --- Bot (опционально) ---
# Раскомментируй, когда будешь готов поднимать бота — иначе он (и awg) не стартуют:
# COMPOSE_PROFILES=bot
BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
NAVIDROME_BASE_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
DISCOCS_BASE_URL=http://backend:7752

# --- awg (туннель для бота, т.к. напрямую наружу бот не ходит) ---
# Только исходящий (клиентский) туннель — входящий порт не пробрасывается.
# Конфиг и стартовый скрипт кладутся руками (секреты, не коммитятся):
#   ${DISCOCS_STATE_DIR}/discocs_awg/config/...
#   ${DISCOCS_STATE_DIR}/discocs_awg/start-awg.sh
