# Прод-окружение для deploy/prod/docker-compose.yml.
# На сервере это файл с секретами — В ГИТ НЕ КОММИТИТСЯ.
# Заполни и положи руками как TARGET_DIR/.env на целевом хосте (см. docs/cicd.md) —
# CI этот файл не деплоит и не трогает, правки на хосте переживают любой билд.

# --- Реестр и тег ---
REGISTRY=192.168.1.41:5000
IMAGE_NS=discocs
TAG=latest                       # latest = последний билд; для отката — конкретный git-sha (напр. a1b2c3d)

# --- Данные сервисов на хосте ---
# Базовый каталог, под ним лежат discocs_backend/, discocs_bot/ и discocs_awg/ (свои
# данные каждого сервиса, без пересечения контекста). Должен существовать до первого up.
DISCOCS_STATE_DIR=/home/infected2202/docker/discocs

# --- Backend ---
DISCOCS_MUSIC_DIR=/path/to/music # хостовый путь к фонотеке, монтируется read-only (должен существовать)
# Implicit user for private admin/CLI and auth-disabled compatibility only.
# Public multiuser requests always use the authenticated session identity.
DISCOCS_OWNER_USER=infected2202

# --- Auth / access gate (Phase 1, см. docs/auth.md) ---
# ВКЛЮЧАТЬ только при выносе в публичный домен и ТОЛЬКО после того, как
# DISCOCS_SERVICE_TOKEN прописан всем внутренним потребителям (бот/воркер/плагин),
# иначе гейт залочит их на следующем авто-деплое.
DISCOCS_AUTH_ENABLED=false
# Общий машинный токен (длинный случайный): напр. `openssl rand -hex 32`.
# Один и тот же у backend, bot и worker.
DISCOCS_SERVICE_TOKEN=
DISCOCS_SESSION_TTL_HOURS=720     # срок жизни сессии (часы), 720 = 30 дней
# Явный allowlist origin'ов для CORS с куками. При auth пусто = CORS выключен.
DISCOCS_CORS_ORIGINS=
# Только эти proxy CIDR могут задавать X-Forwarded-For (Docker bridge по умолчанию).
DISCOCS_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- Public sharing (см. docs/sharing.md) ---
# Capability-ссылки выключены по умолчанию. Укажи только пользователей,
# которым разрешено публиковать аудио наружу.
DISCOCS_SHARING_ENABLED=false
DISCOCS_SHARING_ALLOWED_USERS=infected2202
DISCOCS_SHARE_DEFAULT_TTL_HOURS=168
DISCOCS_SHARE_MAX_TTL_HOURS=8760
DISCOCS_SHARE_MAX_STREAMS_PER_CLIENT=3
DISCOCS_SHARE_MAX_STREAMS=16
# Канонический внешний origin для генерируемых ссылок, без завершающего slash.
DISCOCS_PUBLIC_URL=


# --- Frontend ---
DISCOCS_HTTP_PORT=80

# --- Bot (опционально) ---
# Раскомментируй, когда будешь готов поднимать бота — иначе он (и awg) не стартуют:
# COMPOSE_PROFILES=bot
BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
NAVIDROME_BASE_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
DISCOCS_BASE_URL=http://backend:7752

# --- awg (туннель для бота, т.к. напрямую наружу бот не ходит) ---
# Только исходящий (клиентский) туннель — входящий порт не пробрасывается.
# Конфиг и стартовый скрипт кладутся руками (секреты, не коммитятся):
#   ${DISCOCS_STATE_DIR}/discocs_awg/config/...
#   ${DISCOCS_STATE_DIR}/discocs_awg/start-awg.sh
