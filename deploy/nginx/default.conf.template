map $http_x_forwarded_proto $discocs_public_scheme {
    default $scheme;
    http http;
    https https;
}

map $uri $discocs_log_uri {
    default $uri;
    ~^/share/[A-Za-z0-9_-]+ /share/[redacted];
    ~^/api/v1/public/shares/[A-Za-z0-9_-]+ /api/v1/public/shares/[redacted];
}

map $uri $discocs_referrer_policy {
    default strict-origin-when-cross-origin;
    ~^/share/[A-Za-z0-9_-]+ no-referrer;
    ~^/api/v1/public/shares/[A-Za-z0-9_-]+ no-referrer;
}

map "$uri:$arg_preview" $discocs_robots_policy {
    default "";
    ~^/api/v1/public/shares/[A-Za-z0-9_-]+/preview: "";
    ~^/api/v1/public/shares/[A-Za-z0-9_-]+/cover:1$ "";
    ~^/share/[A-Za-z0-9_-]+ "noindex, nofollow, noarchive";
    ~^/api/v1/public/shares/[A-Za-z0-9_-]+ "noindex, nofollow, noarchive";
}

# Known unfurl clients receive a small server-rendered Open Graph document.
# Normal browsers, including embedded Chromium views, still receive the SPA.
map $http_user_agent $discocs_link_preview_crawler {
    default 0;
    ~*(TelegramBot|facebookexternalhit|Twitterbot|Discordbot|Slackbot|WhatsApp|LinkedInBot|Valve/Steam\ HTTP\ Client|bot|crawler|spider) 1;
}

log_format discocs_masked '$remote_addr - $remote_user [$time_local] '
    '"$request_method $discocs_log_uri $server_protocol" $status $body_bytes_sent '
    '"$http_referer" "$http_user_agent"';

server {
    listen 8080;
    access_log /var/log/nginx/access.log discocs_masked;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy $discocs_referrer_policy always;
    add_header X-Robots-Tag $discocs_robots_policy always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'" always;



    root /usr/share/nginx/html;
    index index.html;

    # Operational surfaces are available only through the backend's private
    # LAN port (:8711 in production). Never expose them through the public UI.
    location ^~ /admin {
        return 404;
    }

    location ^~ /api/map {
        return 404;
    }

    location ^~ /api/v1/workers {
        return 404;
    }

    location ^~ /api/v1/settings {
        return 404;
    }

    location = /api/v1/mixes/settings { return 404; }
    location = /api/v1/instant-mix/settings { return 404; }
    location = /api/v1/instant-mix/requests { return 404; }
    location = /api/v1/albums/settings { return 404; }
    location = /api/v1/navidrome/ping { return 404; }
    location = /api/v1/navidrome/plugin-event { return 404; }
    location = /api/v1/models/download-head-pack { return 404; }
    location = /api/v1/index/rebuild { return 404; }
    location = /api/v1/similar/by-audio { return 404; }

    # These two job families are personal and remain available to a signed-in
    # user. Exact locations take precedence over the general /jobs deny below.
    location = /api/v1/jobs/albums-for-you {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $discocs_public_scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Discocs-Service-Token "";
        proxy_read_timeout 300s;
    }

    location = /api/v1/jobs/albums-for-you/status {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $discocs_public_scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Discocs-Service-Token "";
        proxy_read_timeout 300s;
    }

    location = /api/v1/jobs/flow-profile {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $discocs_public_scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Discocs-Service-Token "";
        proxy_read_timeout 300s;
    }

    location = /api/v1/jobs/flow-profile/status {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $discocs_public_scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Discocs-Service-Token "";
        proxy_read_timeout 300s;
    }

    location ^~ /api/v1/jobs {
        return 404;
    }

    # Public application API — everything else falls through to the SPA.
    location ~ ^/(api|health)(/|$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $discocs_public_scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Discocs-Service-Token "";
        proxy_read_timeout 300s;
        # Audio/cover responses can be multi-megabyte; buffering the full
        # response before forwarding stalls playback and, on a slow/flaky
        # upstream, can trip a premature close that the client sees as a
        # broken HTTP/2 stream. Stream bytes through as they arrive instead.
        proxy_buffering off;
    }

    location ~ "^/share/(?<discocs_share_token>[A-Za-z0-9_-]{40,64})/?$" {
        if ($discocs_link_preview_crawler) {
            rewrite ^ /api/v1/public/shares/$discocs_share_token/preview last;
        }
        try_files $uri /index.html;
    }

    # SPA fallback — all other paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
