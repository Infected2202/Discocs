{
    "name": "fma_small",
    "type": "multi-class classifier",
    "link": "https://essentia.upf.edu/models/classification-heads/fma_small/fma_small-discogs-effnet-1.pb",
    "version": "1",
    "description": "classification of music by genre from discogs-effnet",
    "author": "Pablo Alonso",
    "email": "pablo.alonso@upf.edu",
    "release_date": "2022-11-20",
    "framework": "tensorflow",
    "framework_version": "2.8.0",
    "classes": [
        "Electronic",
        "Experimental",
        "Folk",
        "Hip-Hop",
        "Instrumental",
        "International",
        "Pop",
        "Rock"
    ],
    "model_types": [
        "frozen_model"
    ],
    "dataset": {
        "name": "FMA small",
        "size": "8000 full tracks, 1000 per class",
        "metrics": {
            "test normalized accuracy": 0.59
        }
    },
    "schema": {
        "inputs": [
            {
                "name": "model/Placeholder",
                "type": "float",
                "shape": [
                    1280
                ]
            }
        ],
        "outputs": [
            {
                "name": "model/Sigmoid",
                "type": "float",
                "shape": [
                    8
                ],
                "op": "Sigmoid",
                "output_purpose": "predictions"
            },
            {
                "name": "model/dense_1/BiasAdd",
                "type": "float",
                "shape": [
                    8
                ],
                "op": "fully connected",
                "description": "logits",
                "output_purpose": ""
            },
            {
                "name": "model/dense/BiasAdd",
                "type": "float",
                "shape": [
                    512
                ],
                "op": "fully connected",
                "description": "penultimate layer",
                "output_purpose": ""
            }
        ]
    },
    "citation": "@inproceedings{alonso2022music,\n  title={Music Representation Learning Based on Editorial Metadata from Discogs},\n  author={Alonso-Jim{\\'e}nez, Pablo and Serra, Xavier and Bogdanov, Dmitry},\n  booktitle={Conference of the International Society for Music Information Retrieval (ISMIR)},\n  year={2022}\n}",
    "inference": {
        "sample_rate": 16000,
        "algorithm": "TensorflowPredict2D",
        "embedding_model": {
            "algorithm": "TensorflowPredictEffnetDiscogs",
            "model_name": "discogs-effnet-bs64-1",
            "link": "https://essentia.upf.edu/models/music-style-classification/discogs-effnet/discogs-effnet-bs64-1.pb"
        }
    }
}