# Path to your music library (mounted read-only into the backend container)
DISCOCS_MUSIC_DIR=/path/to/music

# Port nginx listens on (default: 80)
DISCOCS_HTTP_PORT=80

# Backend address — used by nginx to proxy API calls.
# When running backend+nginx together via docker-compose.yml, leave these as-is.
# When deploying nginx separately (e.g. on a CDN server pointing at a remote backend):
BACKEND_HOST=192.168.1.41
BACKEND_PORT=7752
